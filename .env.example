# Copie para .env e preencha com os dados do seu ambiente
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=TrajetoClientes

API_PORT=3001
JWT_SECRET=
JWT_EXPIRES=8h

# Caixa que assina o e-mail do "esqueci minha senha".
MAIL_USUARIO=

# --- Caminho 1: API da Microsoft (Graph) ---
# E o que funciona em tenant do Microsoft 365, onde o SMTP autenticado
# costuma vir desligado. Os tres valores saem do registro do aplicativo
# no Entra ID, com a permissao de APLICATIVO Mail.Send concedida pelo
# administrador. Passo a passo no README.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# --- Caminho 2: SMTP comum (usado so se o de cima estiver vazio) ---
# Se a conta tiver verificacao em duas etapas, gere uma "senha de
# aplicativo" no portal do provedor e use ela em MAIL_SENHA.
MAIL_SENHA=
MAIL_HOST=smtp.office365.com
MAIL_PORT=587

# Login com Outlook. Vem do registro do aplicativo no Entra ID (Azure AD):
#   - redirect URI: http://localhost:5173/outlook (e o endereco de producao)
#   - permissoes delegadas: openid, profile, email, offline_access, User.Read
# O SEGREDO e o "Valor" do segredo do cliente, nao o "ID secreto" que
# aparece ao lado dele no portal. Vazio = o botao do Outlook mostra o
# recado de "nao configurado".
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT=organizations

# Endereco publico do site. E dele que saem os LINKS dos e-mails (o
# botao "abrir a obra" do aviso). Em producao, o dominio de verdade.
APP_URL=http://localhost:5173

# ---------------------------------------------------------------
#  LWN Bot - o assistente que responde dentro do sistema
#
#  O modelo roda NA PROPRIA MAQUINA, servido por Ollama: nao ha
#  cobranca por conversa e nada do que se fala com o bot sai da
#  empresa - o que e o que sustenta a promessa de anonimato da
#  sugestao.
#
#  Na maquina do servidor, uma vez:
#    1. instale o Ollama  ->  https://ollama.com/download
#    2. baixe o modelo    ->  ollama pull llama3.2:3b
#
#  Sem isso o botao continua aparecendo e o bot avisa, na conversa,
#  que nao conseguiu falar com o Ollama.
#
#  Os tres valores abaixo sao OPCIONAIS: sem eles valem os padroes
#  (localhost:11434, llama3.2:3b, 240 segundos).
# ---------------------------------------------------------------
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=llama3.2:3b
OLLAMA_TIMEOUT=90000
