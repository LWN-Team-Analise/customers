# Copie para .env e preencha com os dados do seu ambiente
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=TrajetoClientes

API_PORT=3001
JWT_SECRET=
JWT_EXPIRES=8h

# Conta que envia o e-mail do "esqueci minha senha".
# Se a conta tiver verificacao em duas etapas, gere uma "senha de
# aplicativo" no portal da Microsoft e use ela em MAIL_SENHA.
MAIL_USUARIO=
MAIL_SENHA=
MAIL_HOST=smtp.office365.com
MAIL_PORT=587

# Login com Outlook. Vem do registro do aplicativo no Entra ID (Azure AD):
#   - redirect URI: http://localhost:5173/outlook (e o endereco de producao)
#   - permissoes delegadas: openid, profile, email, offline_access, User.Read
# Vazio = o botao do Outlook mostra o recado de "nao configurado".
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT=organizations
